# Environment Configuration Template
# Copy this file to .env and fill in your values
# NEVER commit .env to version control

# Application Environment
ENVIRONMENT=development  # development, staging, production

# Trading Configuration
TRADING_MODE=paper  # paper (dry-run) or live (real money)
MAX_POSITION_SIZE=1000.00  # USD
MAX_LOSS_PER_TRADE=100.00  # USD
MAX_LOSS_PER_DAY=500.00    # USD
ORDER_RATE_LIMIT=10        # Max orders per minute

# Exchange API Keys (example for Binance)
# EXCHANGE_API_KEY=your_api_key_here
# EXCHANGE_API_SECRET=your_api_secret_here
# EXCHANGE_NAME=binance

# LLM Configuration
# OpenAI
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4
# OPENAI_MAX_TOKENS=4096
# OPENAI_TIMEOUT=30
# OPENAI_DAILY_BUDGET=10.00  # USD

# Anthropic
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-3-sonnet-20240229
# ANTHROPIC_MAX_TOKENS=4096
# ANTHROPIC_TIMEOUT=30
# ANTHROPIC_DAILY_BUDGET=10.00  # USD

# Database (if needed)
# DATABASE_URL=sqlite:///sigma_bot.db
# DATABASE_POOL_SIZE=5

# Logging
LOG_LEVEL=INFO  # DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_FORMAT=json  # json or console
LOG_FILE=logs/sigma-bot.log

# Monitoring (optional)
# SENTRY_DSN=https://...
# METRICS_ENABLED=true

# Kill Switch
KILL_SWITCH_ENABLED=true
KILL_SWITCH_FILE=/tmp/sigma_bot_kill_switch

# Feature Flags
ENABLE_LLM_TRADING=false  # Must explicitly enable
ENABLE_REAL_MONEY=false   # Must explicitly enable

